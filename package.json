{
  "name": "maxous-nav",
  "productName": "Maxou's Nav",
  "version": "1.4.0",
  "description": "Maxou's Nav — navigateur rapide avec bloqueur de pubs intégré",
  "author": "Maxou",
  "main": "src/main.js",
  "scripts": {
    "start": "npm run bundle && electron .",
    "dist": "electron-builder --win",
    "bundle": "esbuild src/preload.js --bundle --platform=node --external:electron --target=node20 --outfile=src/preload.bundle.js --log-level=warning",
    "postinstall": "node scripts/patch-deps.js"
  },
  "dependencies": {
    "@ghostery/adblocker-electron": "^2.20.3",
    "electron-chrome-extensions": "^4.10.0",
    "electron-chrome-web-store": "^0.13.0"
  },
  "devDependencies": {
    "electron": "^45.3.4",
    "electron-builder": "^26.0.0",
    "esbuild": "^0.25.12"
  },
  "build": {
    "appId": "fr.maxou.nav",
    "productName": "Maxou's Nav",
    "executableName": "MaxousNav",
    "copyright": "© 2026 Maxou",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "src/**/*",
      "!src/preload.js",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "build/adblock-engine.bin",
        "to": "adblock-engine.bin"
      },
      {
        "from": "build/blocklist.txt",
        "to": "blocklist.txt"
      }
    ],
    "asarUnpack": [
      "node_modules/@ghostery/adblocker-electron-preload/**",
      "node_modules/electron-chrome-extensions/dist/*.preload.js",
      "node_modules/electron-chrome-web-store/dist/*.preload.js"
    ],
    "electronLanguages": [
      "fr",
      "en-US"
    ],
    "compression": "maximum",
    "win": {
      "icon": "build/icon.ico",
      "target": [
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "portable": {
      "artifactName": "Maxous-Nav-Portable-${version}.${ext}"
    },
    "electronFuses": {
      "runAsNode": false,
      "enableCookieEncryption": true,
      "enableNodeOptionsEnvironmentVariable": false,
      "enableNodeCliInspectArguments": false,
      "enableEmbeddedAsarIntegrityValidation": true,
      "onlyLoadAppFromAsar": true
    }
  },
  "updates": {
    "owner": "Maxoulfrdev",
    "repo": "maxous-nav"
  }
}
